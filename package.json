{
  "name": "quickoper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified-calculation tools for personal money decisions.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-js-budget.mjs",
    "links": "node scripts/check-links.mjs",
    "spacing": "node scripts/check-spacing.mjs",
    "state": "node scripts/check-state.mjs",
    "slots": "node scripts/check-slots.mjs",
    "schema": "node scripts/check-schema.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run budget && npm run links && npm run spacing && npm run state && npm run slots && npm run schema",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.2.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/preact": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
