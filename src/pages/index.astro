---
import BaseLayout from '../layouts/BaseLayout.astro';

// noindex stays until the site has real content and the domain is attached
// (charter §13). A two-page site should not be indexed.
const NOINDEX_UNTIL_LAUNCH = true;
---

<BaseLayout
  title="QuickOper — calculators that show their working"
  description="Verified-calculation tools for personal money decisions. Every calculation runs in your browser, shows its formula, and exports a full schedule. Nothing you type leaves your device."
  noindex={NOINDEX_UNTIL_LAUNCH}
>
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
    Calculators that show their working.
  </h1>

  <p class="text-ink-soft mt-4 text-lg">
    Money tools that give you the whole schedule, not just a number — and prove the
    arithmetic against real published figures.
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-3">
    <div class="rounded-panel border-line bg-surface shadow-panel border p-4">
      <h2 class="text-sm font-semibold">Verified arithmetic</h2>
      <p class="text-ink-soft mt-1 text-sm">
        Every calculation is a separately-tested pure function, checked against a real
        published schedule. The tests are public.
      </p>
    </div>

    <div class="rounded-panel border-line bg-surface shadow-panel border p-4">
      <h2 class="text-sm font-semibold">Nothing is transmitted</h2>
      <p class="text-ink-soft mt-1 text-sm">
        Static site, no backend, no accounts. Your numbers never leave your device — there
        is no server to send them to.
      </p>
    </div>

    <div class="rounded-panel border-line bg-surface shadow-panel border p-4">
      <h2 class="text-sm font-semibold">The whole schedule</h2>
      <p class="text-ink-soft mt-1 text-sm">
        Formula, intermediate values, every period, a chart, and a CSV you can take with
        you.
      </p>
    </div>
  </div>

  <h2 class="mt-12 text-lg font-semibold">Calculators</h2>

  <ul class="mt-3 space-y-3">
    <li>
      <a
        href="/finance/debt-payoff-calculator"
        class="rounded-panel border-line bg-surface hover:border-line-strong block border p-4"
      >
        <span class="text-brand font-medium">Debt payoff — avalanche vs snowball</span>
        <span class="text-ink-soft mt-1 block text-sm">
          Compare both methods against paying minimums. Full month-by-month schedule,
          chart and CSV export.
        </span>
      </a>
    </li>

    <li>
      <a
        href="/finance/coast-fire-calculator"
        class="rounded-panel border-line bg-surface hover:border-line-strong block border p-4"
      >
        <span class="text-brand font-medium"
          >Coast FIRE — when saving becomes optional</span
        >
        <span class="text-ink-soft mt-1 block text-sm">
          How much you need invested today for it to reach your retirement target on its
          own. Year-by-year projection, chart and export.
        </span>
      </a>
    </li>
  </ul>

  <p class="text-ink-soft mt-4 text-sm">
    <a class="text-brand underline" href="/finance">See all calculators</a> — more are added
    one at a time, each tested against a published figure before it ships.
  </p>

  <section class="border-line mt-12 border-t pt-6">
    <h2 class="text-lg font-semibold">Why you can check these numbers</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Every calculation is a tested function, checked against figures published elsewhere,
      and the tests are public. The
      <a class="text-brand underline" href="/methodology">methodology page</a> sets out the
      rounding policy and a worked verification you can repeat — including why
      <code class="numeric">1.005 × 100</code> is the reason most financial software is a cent
      out.
    </p>
    <p class="text-ink-soft mt-3 text-sm">
      Built by <a class="text-brand underline" href="/about"
        >a software engineer, not a financial adviser</a
      >. That distinction matters, and we are precise about it.
    </p>
  </section>
</BaseLayout>
