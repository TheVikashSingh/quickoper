---
import BaseLayout from '../layouts/BaseLayout.astro';
import { QuickCost } from '../components/calculators/QuickCost';

import Guilloche from '../components/ornament/Guilloche.astro';
import NoteFrame from '../components/ornament/NoteFrame.astro';
import ProofChart from '../components/ornament/ProofChart.astro';
import Rule from '../components/ornament/Rule.astro';
import ToolCard from '../components/ToolCard.astro';

import { compareStrategies } from '../lib/calc/debt-payoff';
import { format, fromMajor } from '../lib/calc/money';

/**
 * THE HERO FIGURES ARE COMPUTED, NOT WRITTEN.
 *
 * This runs the real engine, at build time, on the calculator's own default
 * scenario. The curve and every number beside it come out of the same code the
 * tool runs — so the homepage cannot claim a saving the product does not
 * produce, and it cannot go stale when the engine changes. It is zero client
 * JavaScript, because .astro frontmatter never reaches the browser.
 *
 * This is the answer to "the visitor has three seconds". Nobody reads a value
 * proposition in three seconds; they look for evidence the site does something.
 * A curve reaching zero in 19 months against a baseline still climbing is that
 * evidence, and it needs no words at all.
 */
const DEMO_DEBTS = [
  {
    id: 'd1',
    name: 'Store card',
    balance: fromMajor(900),
    annualRate: 0.2999,
    minimumPayment: fromMajor(30),
  },
  {
    id: 'd2',
    name: 'Credit card',
    balance: fromMajor(6000),
    annualRate: 0.2299,
    minimumPayment: fromMajor(150),
  },
  {
    id: 'd3',
    name: 'Personal loan',
    balance: fromMajor(2500),
    annualRate: 0.0699,
    minimumPayment: fromMajor(120),
  },
];

const DEMO_BUDGET = fromMajor(600);
const demo = compareStrategies(DEMO_DEBTS, DEMO_BUDGET);

const opening = DEMO_DEBTS.reduce((sum, d) => sum + d.balance, 0);
const curve = (result: (typeof demo)['avalanche']) => [
  opening,
  ...result.schedule.map((m) => m.totalRemaining),
];

/**
 * The list under the "Calculators" heading, which check-links.mjs requires to
 * contain every /finance/*-calculator route (D50). Data rather than markup so
 * the cards render through the shared ToolCard — the hub had its own
 * hand-written copy of these panels and missed D50's affordance fix entirely
 * (D59).
 */
const CALCULATORS = [
  {
    href: '/finance/debt-payoff-calculator',
    title: 'Debt payoff — avalanche vs snowball',
    summary:
      'Compare both methods against paying minimums. Full month-by-month schedule, chart, CSV and printable report.',
  },
  {
    href: '/finance/mortgage-overpayment-calculator',
    title: 'Mortgage overpayment — what an extra payment removes',
    summary:
      'How much interest and how many years an overpayment takes off, against the contractual schedule. Full amortisation table, chart, CSV and printable report.',
  },
  {
    href: '/finance/coast-fire-calculator',
    title: 'Coast FIRE — when saving becomes optional',
    summary:
      'How much you need invested today for it to reach your retirement target on its own. Year-by-year projection, chart and export.',
  },
];

const CURRENCY = 'USD';

/**
 * THE SCENARIO DESCRIBES ITSELF (D55).
 *
 * "$9,400 of debt, $600 a month" was typed into two places on this page while
 * the actual balances lived in DEMO_DEBTS above. Editing a demo balance would
 * have left the caption stating a total the chart beside it no longer showed —
 * the same failure as "paying $150 instead of $250 removes 44 months": a true
 * number, a false sentence, and nothing able to tell.
 */
const totalOwed = format(opening as typeof DEMO_BUDGET, CURRENCY);
const monthlyBudget = format(DEMO_BUDGET, CURRENCY);

const saved = format(demo.interestSavedVsMinimums, CURRENCY);
const monthsSaved = demo.monthsSavedVsMinimums;
const fastMonths = demo.avalanche.months;
const slowMonths = demo.minimumsOnly.months;
---

<BaseLayout
  title="QuickOper — calculators that show their working"
  description="Money calculators that give you the whole schedule, not just a number: the formula, every period, a chart, and a CSV. Nothing you type is sent anywhere, and every figure can be checked against Excel."
>
  {
    /* The hero is the face of a note: ruled twice, rosettes struck into the
      corners, and a real computed curve where a stock illustration would go. */
  }
  <NoteFrame class="mt-2">
    <div class="relative overflow-hidden">
      <Guilloche
        size={300}
        class="text-brand pointer-events-none absolute -top-24 -right-24 hidden opacity-[0.08] sm:block"
      />

      <p class="engraved-fine text-ink-mute relative">Verified calculation</p>

      <h1 class="relative mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        The whole schedule, not just a number.
      </h1>

      <p class="text-ink-soft relative mt-3 text-base sm:mt-4 sm:text-lg">
        Most calculators hand you one figure and keep the working. These show all of it.
      </p>

      {
        /*
        EVERY TOOL, VISIBLE WITHOUT SCROLLING.

        Removed once to buy vertical space and put back deliberately: a visitor
        who came for a specific calculator should be able to see whether it
        exists before deciding anything, and that is the single most useful
        thing this space can do. It is what calculator.net gets right.

        Compact on purpose — one line on a phone, two short rows at most. The
        list is also honest about its own length: it states the count rather
        than padding the row to look fuller.

        That count is prose and nothing checks it — it said "two" for two pull
        requests after the third tool shipped. The list under "Calculators"
        further down IS checked, by check-links.mjs (D50).
      */
      }
      <nav class="relative mt-4" aria-label="Calculators">
        <div class="flex flex-wrap gap-2">
          <a
            href="/finance/debt-payoff-calculator"
            class="rounded-control bg-masthead text-masthead-ink hover:bg-brand border-brand border px-4 py-2 text-sm font-semibold"
          >
            Debt payoff
          </a>
          <a
            href="/finance/mortgage-overpayment-calculator"
            class="rounded-control bg-masthead text-masthead-ink hover:bg-brand border-brand border px-4 py-2 text-sm font-semibold"
          >
            Mortgage overpayment
          </a>
          <a
            href="/finance/coast-fire-calculator"
            class="rounded-control bg-masthead text-masthead-ink hover:bg-brand border-brand border px-4 py-2 text-sm font-semibold"
          >
            Coast FIRE
          </a>
          <a
            href="/verify"
            class="rounded-control bg-masthead text-masthead-ink hover:bg-brand border-brand border px-4 py-2 text-sm font-semibold"
          >
            Check our arithmetic
          </a>
        </div>
        <p class="text-ink-mute mt-2 text-xs">
          Three calculators today. More are added one at a time, each tested against a
          published figure before it ships.
        </p>
      </nav>
    </div>
  </NoteFrame>

  {
    /*
    THE ONE INTERACTIVE THING ABOVE THE FOLD.

    Everything else on this page is build-time HTML. This is an island, and the
    only reason the homepage ships JavaScript at all — a deliberate exception to
    rule 9, recorded in DECISIONS and measured in the pull request that added
    it. A visitor who types a number into a box has engaged; a visitor who reads
    a value proposition has not.

    client:load rather than client:visible on purpose: it is the first thing on
    the screen, so deferring hydration would leave the input dead for exactly
    the moment that matters.
  */
  }
  <section class="mt-8" aria-labelledby="quick-heading">
    <div class="rounded-panel border-line-strong bg-surface border p-1.5">
      <div class="border-engrave-strong rounded-control border p-4 sm:p-6">
        <p class="engraved-fine text-ink-mute">Try it now</p>
        <h2 id="quick-heading" class="text-ink mt-1 text-xl font-semibold sm:text-2xl">
          What is a debt actually costing you?
        </h2>

        <div class="mt-5">
          <QuickCost client:load>
            <Fragment slot="privacy">
              Worked out in your browser. Nothing you type is sent anywhere, and nothing
              is saved.
            </Fragment>
          </QuickCost>
        </div>
      </div>
    </div>
  </section>

  {
    /* Proof, computed at build time by the real engine on the calculator's own
      default scenario — see the frontmatter. */
  }
  <section class="mt-10" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="sr-only">What the debt payoff calculator produces</h2>

    <div class="rounded-panel border-line-strong bg-surface border p-1.5">
      <div class="border-engrave-strong rounded-control border p-4 sm:p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="engraved text-ink text-xs">
            {totalOwed} of debt, {monthlyBudget} a month
          </p>
          <p class="text-ink-mute text-xs">
            Worked out in your browser · nothing transmitted
          </p>
        </div>

        <ProofChart
          class="mt-4"
          caption={`Total balance by month. Paying ${monthlyBudget} a month with the avalanche method clears ${totalOwed} of debt in ${fastMonths} months. Paying only the minimums takes ${slowMonths} months and costs ${saved} more in interest.`}
          series={[
            { label: 'Minimum payments only', points: curve(demo.minimumsOnly) },
            { label: 'Avalanche', points: curve(demo.avalanche), emphasis: true },
          ]}
        />

        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Debt-free in</dt>
            <dd class="numeric text-ink mt-0.5 text-xl font-semibold">
              {fastMonths} months
            </dd>
            <dd class="text-ink-mute text-xs">instead of {slowMonths}</dd>
          </div>
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Interest saved</dt>
            <dd class="numeric text-positive mt-0.5 text-xl font-semibold">{saved}</dd>
            <dd class="text-ink-mute text-xs">against paying minimums</dd>
          </div>
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Sooner by</dt>
            <dd class="numeric text-ink mt-0.5 text-xl font-semibold">
              {monthsSaved} months
            </dd>
            <dd class="text-ink-mute text-xs">
              <a class="text-brand underline" href="/finance/debt-payoff-calculator">
                run your own figures
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="text-ink-mute mt-2 text-xs">
      Every figure above is produced by the calculator itself when this page is built —
      not written by hand.
    </p>
  </section>

  <Rule class="mt-12" />

  <section class="mt-8">
    <h2 class="text-2xl font-semibold tracking-tight">
      What the big comparison sites will not give you
    </h2>

    <p class="text-ink-soft mt-2">
      Not a claim about their arithmetic — a claim about their incentives. A site funded
      by lead generation needs your email and your attention. This one has no backend to
      send anything to.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">Your numbers stay here</h3>
          <p class="text-ink-soft mt-2 text-sm">
            There is no server to send them to. No account, no email wall, no analytics
            attached to what you typed. The claim is structural, not a promise.
          </p>
        </div>
      </div>

      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">Arithmetic you can check</h3>
          <p class="text-ink-soft mt-2 text-sm">
            Five formulas reproduce every published figure in your own spreadsheet —
            including the two where we differ, and by exactly how much.
          </p>
        </div>
      </div>

      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">The document, not the answer</h3>
          <p class="text-ink-soft mt-2 text-sm">
            Every period, a chart, a CSV, and a printable schedule with a link back to
            your exact scenario. Yours to keep and to send on.
          </p>
        </div>
      </div>
    </div>

    <p class="text-ink-soft mt-4 text-sm">
      <a class="text-brand underline" href="/verify">Check our arithmetic yourself</a> — five
      spreadsheet formulas and the SEC's own calculator, about ten minutes.
    </p>
  </section>

  <Rule class="mt-12" />

  <section class="mt-8">
    <h2 class="text-2xl font-semibold tracking-tight">Calculators</h2>

    {
      /*
        EVERY calculator belongs in this list, in the same order as the hero row
        above. The mortgage tool was missing here for four pull requests while
        being present in the hero — so the page contradicted itself, and a
        visitor who scrolled to the section headed "Calculators" was told there
        were two (D50).

        `check-links.mjs` now fails the build if a calculator route is absent
        from this list, because D41's orphan check could not: the route *was*
        linked from the hero, so every gate was green.

        On the affordance: these are whole-card links, and a bordered panel does
        not read as one. Hover moves the arrow and underlines the title; the
        global :focus-visible rule in global.css supplies the keyboard ring, so
        it is deliberately not repeated here.
      */
    }
    <ul class="mt-4 space-y-3">
      {
        CALCULATORS.map((tool) => (
          <li>
            <ToolCard href={tool.href} title={tool.title} summary={tool.summary} />
          </li>
        ))
      }
    </ul>

    <h3 class="mt-8 text-lg font-semibold">Derivations</h3>
    <p class="text-ink-soft mt-1 text-sm">
      The arithmetic behind the tools, worked out with real figures.
    </p>

    <ul class="text-ink-soft mt-3 space-y-1 text-sm">
      <li>
        <a class="text-brand underline" href="/credit-card-interest"
          >How credit card interest is actually calculated</a
        > — the daily periodic rate, and why 22.99% costs 25.838%.
      </li>
      <li>
        <a class="text-brand underline" href="/monthly-return-rate"
          >Why a 7% return is not 0.583% a month</a
        > — one division that overstates thirty years by $50,424.
      </li>
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">Who writes this</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Built by <a class="text-brand underline" href="/about"
        >a software engineer, not a financial adviser</a
      >. That distinction matters and we are precise about it: this site does arithmetic
      and shows its working. It never tells you what to do with your money.
    </p>
  </section>
</BaseLayout>
