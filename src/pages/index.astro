---
import BaseLayout from '../layouts/BaseLayout.astro';

import Guilloche from '../components/ornament/Guilloche.astro';
import NoteFrame from '../components/ornament/NoteFrame.astro';
import Rule from '../components/ornament/Rule.astro';

import { VERTICALS, calculatorsIn, derivationsIn, toolsIn } from '../lib/catalogue';

/**
 * THE ROOT IS A ROUTER, AND THAT IS A REVERSAL WORTH READING (D91).
 *
 * This page used to open with a debt payoff teaser, a computed payoff curve and
 * a flat row of every calculator on the site. All of it was right when finance
 * was the only vertical: D34 put an island here on the reasoning that a visitor
 * who types a number into a box has engaged and one who reads a value
 * proposition has not, and D32 put a computed chart here so the page proved
 * rather than claimed.
 *
 * Machining opened on 2026-09-01 and neither decision was revisited. The URL
 * migration then enforced "the root is site-level" for ROUTES, and D88 gave the
 * root its own palette — so the root stopped LOOKING like finance while still
 * BEING finance: seven sections of debt-payoff material before the word
 * "machining" appeared anywhere on it.
 *
 * So the island moved to /finance, where its subject is, and this page does the
 * one job a root with two children can honestly do — say what the site is, and
 * send you to the right half of it. It ships 0.53 KB, the theme script and
 * nothing else, and is the only page whose JavaScript went DOWN when it got
 * better.
 *
 * Nothing here is written out by hand: the verticals, their tools and their
 * counts all come from src/lib/catalogue.ts (D82), so a third vertical is one
 * registry entry and no edit to this file.
 */

const routes = VERTICALS.map((v) => ({
  ...v,
  tools: toolsIn(v.id).length,
  calculators: calculatorsIn(v.id).length,
  derivations: derivationsIn(v.id).length,
}));

const totalCalculators = routes.reduce((n, r) => n + r.calculators, 0);

/**
 * What each half is FOR, in the one sentence a visitor needs to decide whether
 * it is theirs. Kept here rather than in the catalogue because it describes a
 * vertical rather than a page, and the catalogue is a page registry.
 *
 * No computed figures in these. A hand-typed number beside a build-time count is
 * exactly the drift D47, D55 and D62 each recorded — the counts below are
 * derived, and the prose deliberately carries none.
 */
const BLURB: Record<string, string> = {
  finance:
    'Debt, mortgages and long-horizon saving. Every tool gives you the full period-by-period schedule, a chart, a spreadsheet and a printable report — and states which convention it used to get there.',
  machining:
    'Tap drills, thread engagement, feeds and speeds. Metric-first, generated from the standards rather than transcribed from a chart, and honest about the sizes it does not carry.',
};
---

<BaseLayout
  vertical="site"
  title="QuickOper — calculators that show their working"
  description="Verified calculators for money and for the shop floor. Every one gives you the whole schedule, not just a number: the formula, every period, a chart and a spreadsheet. Nothing you type is sent anywhere."
>
  {
    /* The hero is the face of a note: ruled twice, rosettes struck into the
      corners, and the site's whole claim in two lines. */
  }
  <NoteFrame class="mt-2">
    <div class="relative overflow-hidden">
      <Guilloche
        size={300}
        class="text-brand pointer-events-none absolute -top-24 -right-24 hidden opacity-[0.16] sm:block"
      />

      <p class="engraved-fine text-ink-mute relative">Verified calculation</p>

      <h1 class="relative mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">
        The whole schedule, not just a number.
      </h1>

      <p class="text-ink-soft relative mt-3 text-base sm:mt-4 sm:text-lg">
        Most calculators hand you one figure and keep the working. These show all of it —
        every period, the formula, and a result you can check against someone else's.
      </p>

      <p class="text-ink-mute relative mt-3 text-sm">
        {totalCalculators} calculators across {routes.length} subjects, each tested against
        a published figure before it ships.
      </p>
    </div>
  </NoteFrame>

  {
    /*
      THE TWO SUBJECTS, IMMEDIATELY, AND THIS IS THE PAGE'S ONE JOB.

      They carry their own vertical's colour as a key — the only place on the
      site where both accents appear, because everywhere else one vertical owns
      the page and --color-brand already is its colour. A visitor should be able
      to see that there are two subjects before reading a word (D88).

      Deliberately NOT components/ToolCard.astro. That renders one page; this
      renders a whole half of the site, and it is the primary action on the
      primary page. Reusing the card would have given them identical weight.
    */
  }
  <section class="mt-10" aria-labelledby="routes-heading">
    <h2 id="routes-heading" class="sr-only">Choose a subject</h2>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        routes.map((r) => (
          <li data-vertical-key={r.id}>
            <a
              href={r.hub}
              data-route-card
              class="rounded-panel border-line-strong bg-surface hover:bg-sunken hover:border-brand group flex h-full flex-col border p-5 transition-colors sm:p-6"
            >
              <span class="section-head section-head--key flex items-baseline justify-between gap-3">
                <span>{r.label}</span>
                <span class="text-ink-mute text-sm font-normal transition-transform group-hover:translate-x-0.5">
                  &rarr;
                </span>
              </span>

              <span class="text-ink-soft mt-3 block text-sm">{BLURB[r.id]}</span>

              <span class="text-ink-mute engraved mt-4 block text-xs">
                {r.calculators} calculators
                {r.tools > r.calculators && <> · {r.tools - r.calculators} reference</>}
                {r.derivations > 0 && <> · {r.derivations} derivations</>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Rule class="mt-12" />

  {
    /*
      The site-level claim, which is the same whichever half you came for. It
      used to be headed "What the big comparison sites will not give you" and
      argued about lead generation and spreadsheets — true of the money side and
      meaningless to a machinist. Same three promises, stated so they hold for
      both.
    */
  }
  <section class="mt-8">
    <h2 class="text-2xl font-semibold tracking-tight">What every tool here does</h2>

    <p class="text-ink-soft mt-2">
      Not a claim about anyone else's arithmetic — a claim about incentives. A site funded
      by lead generation needs your email and your attention. This one has no backend to
      send anything to.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">Your numbers stay here</h3>
          <p class="text-ink-soft mt-2 text-sm">
            There is no server to send them to. No account, no email wall, no analytics
            attached to what you typed. The claim is structural, not a promise.
          </p>
        </div>
      </div>

      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">Arithmetic you can check</h3>
          <p class="text-ink-soft mt-2 text-sm">
            Every expected value in the tests cites where it came from — a manufacturer's
            published table, a competitor's own output, or a formula you can reproduce in
            a spreadsheet.
          </p>
        </div>
      </div>

      <div class="rounded-panel border-line bg-surface shadow-panel border p-1.5">
        <div class="border-engrave-strong rounded-control h-full border p-3">
          <h3 class="engraved text-ink text-xs">The document, not the answer</h3>
          <p class="text-ink-soft mt-2 text-sm">
            Every period, a chart, a spreadsheet and a printable schedule with a link back
            to your exact scenario. Yours to keep and to send on.
          </p>
        </div>
      </div>
    </div>

    <p class="text-ink-soft mt-4 text-sm">
      <a class="text-brand underline" href="/methodology">How we verify our numbers</a> — the
      rounding policy, the sources, and a worked check for each subject.
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">Who writes this</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Built by <a class="text-brand underline" href="/about"
        >a software engineer, not a financial adviser</a
      >. That distinction matters and we are precise about it: this site does arithmetic
      and shows its working. It never tells you what to do with your money.
    </p>
  </section>
</BaseLayout>
