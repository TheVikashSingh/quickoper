---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

/**
 * The site-level app index, linked from the masthead.
 *
 * It routes to the per-vertical app pages rather than describing the apps
 * itself. That split matters: conversion happens in context — a machinist
 * should read about the machining app on a machining-coloured page, not in a
 * directory beside a mortgage tool — so this page's only job is to get people
 * to the right one and to say honestly what is and is not out yet.
 */

type AppStatus = 'in-development' | 'live';

interface AppEntry {
  readonly href: string;
  readonly vertical: string;
  readonly name: string;
  readonly platform: string;
  readonly status: AppStatus;
  readonly summary: string;
}

const APPS: readonly AppEntry[] = [
  {
    href: '/machining/app',
    vertical: 'Machining',
    name: 'Machinist Calculator',
    platform: 'Android',
    status: 'in-development',
    summary:
      'Metric-first feeds and speeds, thread and tap drill sizing, drill charts. Offline, one payment, no subscription.',
  },
];

const STATUS_COPY = {
  'in-development': 'In development — not yet released',
  live: 'On Google Play',
} as const;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Apps',
    url: `${SITE.url}/apps`,
    description:
      'Mobile apps from QuickOper. Each is built on the same verified arithmetic as the calculators on this site.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: `${SITE.url}/apps` },
    ],
  },
];
---

<BaseLayout
  vertical="site"
  title="Apps — the calculators, offline on a phone | QuickOper"
  description="Where the QuickOper calculators are heading on mobile: one Android machinist app, in development, one payment and no subscription. What exists today, what does not, and where to read about each."
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-brand font-mono text-xs tracking-widest uppercase">Apps</p>
    <h1 class="font-display text-ink mt-3 text-4xl leading-tight font-semibold">
      The calculators, in your pocket
    </h1>
    <p class="text-ink-soft mt-4 max-w-prose text-lg">
      The web tools run in a browser and stop when you close the tab. The apps carry the
      same arithmetic onto a phone that works without signal, remembers your machines, and
      is paid for once.
    </p>

    <ul class="mt-10 space-y-4">
      {
        APPS.map((app) => (
          <li class="border-line-strong bg-surface shadow-panel rounded-panel border p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-ink-mute font-mono text-xs tracking-widest uppercase">
                {app.vertical} · {app.platform}
              </span>
              <span
                class={
                  app.status === 'live'
                    ? 'text-positive font-mono text-xs'
                    : 'text-caution font-mono text-xs'
                }
              >
                {STATUS_COPY[app.status]}
              </span>
            </div>
            <h2 class="font-display text-ink mt-2 text-xl font-semibold">{app.name}</h2>
            <p class="text-ink-soft mt-1 max-w-prose text-sm">{app.summary}</p>
            <a
              class="text-brand mt-3 inline-block font-semibold underline underline-offset-2"
              href={app.href}
            >
              Read more &rarr;
            </a>
          </li>
        ))
      }
    </ul>

    <section class="border-line mt-12 border-t pt-6">
      <h2 class="font-display text-ink text-xl font-semibold">Why an app at all</h2>
      <p class="text-ink-soft mt-3 max-w-prose">
        A browser tab is the wrong shape for a shop floor. There is often no signal, the
        same figures get recalculated thirty times a day, and the machine and material you
        are working with do not change between them. That is what the apps are for — the
        web tools stay free and complete for the one-off question.
      </p>
      <p class="text-ink-soft mt-3 max-w-prose">
        Nothing moves behind a paywall to make that case. Every calculator on this site
        stays as it is: the whole schedule, the chart, the spreadsheet export and the
        printable report, with no account and no limit on how often you use it. An app
        earns its money by being the better shape for repeated work, or it does not
        deserve any.
      </p>
    </section>

    <section class="border-line mt-10 border-t pt-6">
      <h2 class="font-display text-ink text-xl font-semibold">
        The arithmetic is the same, and it is public either way
      </h2>
      <p class="text-ink-soft mt-3 max-w-prose">
        The reason to trust a figure on a phone is the same as the reason to trust one in
        a browser: you can check it. Every calculation here is a tested function, and
        every expected value in those tests cites where it came from in a comment beside
        it. Some of those sources are published third-party results — a manufacturer's tap
        drill table, a competing calculator's own output. Others are standard formulas you
        can reproduce in a spreadsheet in under a minute. Which one applies is stated per
        engine rather than glossed, because "verified" means nothing if it covers both
        without distinction.{' '}
        <a class="text-brand underline" href="/methodology">How we verify our numbers</a> sets
        out the method, and the tests themselves are public.
      </p>
    </section>

    <section class="border-line mt-10 border-t pt-6">
      <h2 class="font-display text-ink text-xl font-semibold">What is not here yet</h2>
      <p class="text-ink-soft mt-3 max-w-prose">
        One app, for machining, on Android, and it has not been released. There is no
        money app and no iOS build, and neither is announced — saying otherwise would put
        a promise on this page that nothing behind it can keep. There is no release date
        for the same reason.
      </p>
      <p class="text-ink-soft mt-3 max-w-prose">
        This page lists what exists rather than what is hoped for, which is why it is
        short. It grows when something ships.
      </p>
    </section>
  </div>
</BaseLayout>
