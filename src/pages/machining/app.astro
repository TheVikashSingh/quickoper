---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { APP, playLink, SITE } from '../../lib/site';

/**
 * The Android app page — the conversion surface for the machining vertical.
 *
 * Per-vertical rather than a site-wide /apps entry, because conversion needs
 * context: a machinist arriving from the tap drill calculator should read about
 * their app on a machining-coloured page, not in a directory beside a mortgage
 * tool. /apps exists as the masthead entry point and routes here.
 *
 * THE APP IS BUILT BUT NOT YET ON GOOGLE PLAY (`APP.live` in `lib/site.ts`),
 * so until launch nothing on this page may read as buyable. Status is stated
 * in the eyebrow and again at the foot. The SoftwareApplication node carries
 * NO `offers`: a price in a rich result for an app nobody can buy is a lie
 * told by markup, and the launch price is still the operator's decision
 * (roadmap A5). On launch day `APP.live` turns the eyebrow, the lead, "Getting
 * it" and the status list over to the Play listing; the offer is added only
 * once the price is decided.
 *
 * Every claim about what the app does is taken from its fact-checked Play
 * listing (machinist-calc-app `store/play/listing.md`). An earlier version of
 * this page promised "configurable to six" decimal places and "tap a number to
 * see the formula"; the app has neither, and both are gone.
 *
 * There is deliberately no signup form and no demand-test CTA. The decision to
 * build has been taken, so asking visitors to vote on it would be theatre.
 */

/**
 * Verbatim, from Play Store reviews of competing apps.
 *
 * Collected 2026-08-30/09-01: 1,908 reviews across 41 machinist-calculator apps
 * in the US, GB, AU and DE, of which 511 were negative. Attributed by rating and
 * app, never by username.
 *
 * These are the reason the app is being built, and they are the one thing on
 * this page that could not have been written without doing the work.
 */
const COMPLAINTS = [
  {
    quote:
      'cant see where there is speeds and feeds for hss drills in metric. Yes, the majority of the planet in the 21st century uses Metric.',
    source: '1★ · FSWizard Machinist Calculator',
  },
  {
    quote: 'Useless for lathes or metric users. Needs lots more data for metric taps',
    source: '2★ · FSWizard Machinist Calculator',
  },
  {
    quote:
      'I actually regret spending £12, milling calculations are all in imperial measurements. I use the metric system, and not being able to choose which on milling and turning…',
    source: '2★ · CNC Machinist Calculator Pro',
  },
  {
    quote:
      'I don’t know of any machinist on Earth who checks true position and rounds their deviations and end result. This calculator is worthless without at least 4 places behind the zero.',
    source: '1★ · FSWizard Pro Machinist Calc',
  },
  {
    quote:
      '…the fundamental failure of the developer to not make [tools] in feed per revolution…',
    source: '1★ · FSWizard Machinist Calculator',
  },
  {
    quote: 'The metric drill sizes are incorrect… almost always rounded to 0.5mm',
    source: '1★ · Tap And Drill Chart Calculator',
  },
];

const DOING = [
  {
    title: 'Metric first, inch where needed',
    body: 'Every length, speed and pitch field has its own switch: mm or inch, m/min or sfm, pitch in mm or threads per inch. Switching converts the number, with no drift.',
  },
  {
    title: 'Feed per tooth, per rev and per minute',
    body: 'Milling, turning, drilling, boring and tapping: spindle speed, feed per tooth and per rev, table feed and removal rate, and power from your own kc1.1 and mc.',
  },
  {
    title: 'Drills that exist',
    body: 'The tap drill comes from real metric, number, letter and fractional drills, and the app reports the thread engagement that drill actually gives — which is rarely the round number you asked for.',
  },
  {
    title: 'The tool makers’ own cutting data',
    body: 'Cutting speeds, and feeds where printed, for 27 materials from Walter, Kennametal, ISCAR, Mitsubishi Materials, Harvey, Helical and OSG, each naming the maker, the tool or grade and the page. Never averaged; where no maker publishes, it says so.',
  },
  {
    title: 'Every answer shows its working',
    body: 'Open the working under any answer: the formula, your numbers in it, and the standard it follows where there is one. Each answer is rounded once, on the way to the screen.',
  },
  {
    title: 'Nine tools, offline',
    body: 'Tap drill, feeds and speeds, countersink and chamfer, bolt circle and grid, triangle, true position, drill chart, materials and conversions, with a trig calculator on the home screen. No internet access; English and German.',
  },
];

const NOT_DOING = [
  [
    'Per-brand M-code lists',
    'The most-requested missing feature in the reviews, and a content treadmill: it would need updating forever and would be wrong the moment a control is revised. Refused deliberately.',
  ],
  [
    'A subscription',
    'One purchase, and it follows your Google account onto your next phone. Machinists in the reviews were explicit that they would pay for a tool and would not rent one.',
  ],
  ['Ads', 'None, anywhere, at any tier.'],
  ['An account', 'Nothing to sign up for. Nothing to sign in to.'],
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: APP.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android',
    // NO `offers` node until the app is on Google Play AND its price is
    // decided (roadmap A5): a price here would put a purchasable claim into
    // search results for something nobody can buy.
    description: APP.live
      ? 'A metric-first machinist calculator for Android: tap drill, feeds and speeds with the tool makers’ own cutting data, countersinks, bolt circles, triangles, true position, drill chart and conversions. Offline, one payment.'
      : 'A metric-first machinist calculator for Android: tap drill, feeds and speeds with the tool makers’ own cutting data, countersinks, bolt circles, triangles, true position, drill chart and conversions. Built, not yet on Google Play.',
    url: `${SITE.url}/machining/app`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Machining',
        item: `${SITE.url}/machining`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Android app',
        item: `${SITE.url}/machining/app`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${APP.name} — the Android app`}
  description={APP.live
    ? `${APP.name}: a metric-first machinist calculator for Android — tap drill, feeds and speeds with the tool makers' cutting data, and seven more tools. Offline, one payment. On Google Play.`
    : `${APP.name}: a metric-first machinist calculator for Android — tap drill, feeds and speeds with the tool makers' cutting data, and seven more tools. Offline, one payment. Built, not yet on Google Play.`}
  vertical="machining"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <nav class="text-ink-mute font-mono text-xs">
      <a class="hover:text-brand underline-offset-2 hover:underline" href="/machining"
        >Machining</a
      > / Android app
    </nav>

    <p
      class="border-caution text-ink-soft mt-4 inline-block border-l-4 py-1 pl-3 font-mono text-xs tracking-widest uppercase"
    >
      {APP.live ? 'On Google Play' : 'Built · not yet on Google Play'}
    </p>

    <h1 class="font-display text-ink mt-3 text-4xl leading-tight font-semibold">
      A machinist calculator that works in millimetres
    </h1>
    <p class="text-ink-soft mt-4 max-w-prose text-lg">
      Every machining calculator on the Play Store is imperial-first with metric bolted
      on. {APP.name} works the other way round.{' '}
      {
        APP.live
          ? 'It is on Google Play; this page is what it does, and why it was built.'
          : 'It is built and not yet on Google Play; this page is what it does, and why it was built.'
      }
    </p>

    <!-- ── Why ─────────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">
        Why — in the words of people who already paid
      </h2>
      <p class="text-ink-soft mt-3 max-w-prose">
        These are verbatim from Play Store reviews of competing apps. I read{' '}
        <strong class="text-ink">1,908 reviews across 41 machinist calculators</strong> in the
        US, UK, Australia and Germany. 511 were negative, and the single most common complaint
        — across nine independent apps — was metric handling.
      </p>
      <div class="mt-5 space-y-4">
        {
          COMPLAINTS.map((c) => (
            <blockquote class="border-line text-ink-soft border-l-2 pl-4">
              <p class="max-w-prose italic">“{c.quote}”</p>
              <cite class="text-ink-mute mt-1 block font-mono text-xs not-italic">
                {c.source}
              </cite>
            </blockquote>
          ))
        }
      </div>
    </section>

    <!-- ── What it does ────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">What it does</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          DOING.map((d) => (
            <div class="border-line bg-surface rounded-panel border p-4">
              <h3 class="font-display text-ink font-semibold">{d.title}</h3>
              <p class="text-ink-soft mt-1 text-sm">{d.body}</p>
            </div>
          ))
        }
      </div>
      <p class="text-ink-mute mt-4 max-w-prose text-sm">
        You can judge the arithmetic here first. The{' '}
        <a class="text-brand underline underline-offset-2" href="/machining"
          >calculators on this site</a
        > run the same formulas, cite the same standards and show the same working. If one gets
        a number wrong, tell me and I will fix it there first.
      </p>
    </section>

    <!-- ── What it won't do ────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">What it will not do</h2>
      <dl class="mt-4 space-y-3">
        {
          NOT_DOING.map(([title, body]) => (
            <div class="border-line border-t pt-3">
              <dt class="text-ink font-semibold">{title}</dt>
              <dd class="text-ink-soft mt-1 max-w-prose text-sm">{body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── Get it ──────────────────────────────────────────────────────── -->
    <section
      class="border-line-strong bg-surface shadow-panel rounded-panel mt-12 border p-6"
    >
      <h2 class="font-display text-ink text-2xl font-semibold">Getting it</h2>
      <p class="text-ink-soft mt-3 max-w-prose">
        {APP.live ? 'It is on Google Play.' : 'It will be on Google Play.'} One payment, no
        subscription, no ads, no account — and it follows your Google account onto your next
        phone, which is not a feature so much as using the platform correctly. Every calculator
        and the working are free; the one payment unlocks the tool makers' cutting figures,
        after 30 free lookups.
      </p>
      {
        APP.live ? (
          <a
            class="text-brand mt-4 inline-block text-lg font-semibold underline underline-offset-2"
            href={playLink('machining-app')}
            rel="noopener"
          >
            Get {APP.name} on Google Play &rarr;
          </a>
        ) : (
          <p class="border-caution text-ink-soft mt-4 inline-block border-l-4 py-1 pl-3 font-mono text-xs tracking-widest uppercase">
            Play Store link appears here on release
          </p>
        )
      }
      {
        !APP.live && (
          <p class="text-ink-mute mt-4 max-w-prose text-sm">
            Until then the{' '}
            <a
              class="text-brand underline underline-offset-2"
              href="/machining/tap-drill-calculator"
            >
              tap drill calculator
            </a>{' '}
            on this site runs the same arithmetic, cites the same standards and shows the
            same working. It is free and stays free.
          </p>
        )
      }
    </section>

    <!-- ── Status ──────────────────────────────────────────────────────── -->
    <section class="border-line mt-12 border-t pt-6">
      <h2 class="font-display text-ink text-xl font-semibold">Where it actually is</h2>
      <ul class="text-ink-soft mt-3 space-y-2 text-sm">
        <li class="border-positive border-l-2 pl-3">
          <strong class="text-ink">Live now:</strong>{' '}
          <a class="text-brand underline underline-offset-2" href="/machining"
            >the machining calculators</a
          > on this site — tap drill, feeds and speeds, countersink, bolt circle, triangle,
          true position, the unit converter and the drill chart. Same formulas, same standards,
          free, no signup.
        </li>
        {
          APP.live ? (
            <li class="border-positive border-l-2 pl-3">
              <strong class="text-ink">On Google Play:</strong> {APP.name}, with all nine
              tools and the tool makers' cutting data.
            </li>
          ) : (
            <>
              <li class="border-positive border-l-2 pl-3">
                <strong class="text-ink">Built:</strong> {APP.name}, all nine tools, in
                English and German, checked on a phone.
              </li>
              <li class="border-caution border-l-2 pl-3">
                <strong class="text-ink">Next:</strong> Google Play's checks for a new
                developer, a closed test, and then the release.
              </li>
            </>
          )
        }
      </ul>
      <p class="text-ink-mute mt-4 max-w-prose text-sm">
        {
          APP.live
            ? 'It is built in evenings by one person, and the arithmetic is checked against published standards before anything ships — which is slower than guessing and the only way a tool like this is worth installing.'
            : 'No release date, because Google’s checks set it and I would be making it up. It is built in evenings by one person, and the arithmetic is checked against published standards before anything ships — which is slower than guessing and the only way a tool like this is worth installing.'
        }
      </p>
    </section>
  </div>
</BaseLayout>
