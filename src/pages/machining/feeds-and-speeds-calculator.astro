---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sourceRef } from '../../lib/schema';
import { SITE } from '../../lib/site';

/**
 * Feeds and speeds.
 *
 * ─── What this page refuses to do ───────────────────────────────────────────
 *
 * It does not tell you what cutting speed to use. There is no material
 * dropdown, and there will not be one until somebody has verified a table
 * against a manufacturer's published data.
 *
 * Vc and fz are not properties of a material — they are properties of a
 * material, a substrate, a coating, a geometry, a coolant strategy and a
 * machine. Sandvik, Kennametal and Seco publish different figures for the same
 * steel, per insert grade. A calculator that answers "what Vc for stainless?"
 * from a table it invented looks authoritative, is specific, and breaks tools.
 *
 * So the data sheet supplies Vc and fz; this page does the arithmetic, which is
 * the tedious and error-prone half. That is also the division of labour a
 * machinist should be using anyway.
 *
 * ─── Turning is a first-class operation, not a tab ──────────────────────────
 *
 * Seven separate apps in the review corpus drew turning complaints — "Useless
 * for lathes", "Lacks Boring Operation", "cut time calculation in turning
 * section doesn't work". Milling and turning here share the unit handling and
 * the display, and turning uses its OWN MRR formula rather than the milling one
 * relabelled.
 */

const LAST_VERIFIED = '2026-09-01';

const SOURCES = [
  {
    label: 'ISO 3002-1 — basic quantities in cutting and grinding. ICS 25.100',
    url: 'https://www.iso.org/ics/25.100/x/',
    retrieved: LAST_VERIFIED,
  },
  {
    label: 'Sandvik Coromant — metalworking formulas and definitions (technical guide)',
    url: 'https://www.sandvik.coromant.com/en-gb/knowledge',
    retrieved: LAST_VERIFIED,
  },
].map((s) => sourceRef.parse(s));

const FAQ = [
  {
    q: 'Why does it not tell me the cutting speed?',
    a: 'Because it would have to make it up. Cutting speed is a property of the material AND the insert grade, coating, geometry, coolant and machine — which is why Sandvik, Kennametal and Seco publish different numbers for the same steel. The figure on your tooling data sheet is the right one; this page turns it into rpm and feed without arithmetic errors.',
  },
  {
    q: 'Why show both mm/rev and mm/min?',
    a: 'Because a lathe operator works in feed per revolution and a mill operator in feed per minute, and they are the same cut described two ways. Showing only one picks a side. A reviewer of a competing app called the missing mm/rev "the fundamental failure of the developer", and he had a point.',
  },
  {
    q: 'Is the chip thickness figure exact?',
    a: 'No, and it is labelled approximate. It uses the standard radial-chip-thinning approximation, fz × √(ae/Dc), which is what the tooling guides themselves publish for sizing a cut. Exact chip thickness depends on cutter geometry your vendor knows and this page does not.',
  },
  {
    q: 'The power figure looks low compared to my machine rating.',
    a: 'It is net power at the cut, before drive losses beyond the efficiency you entered, and it is the power the cut itself demands. Compare it against the spindle rating with a margin; a cut that computes at 90% of rated power is not a cut you want to take. Note also that kc1.1 and mc are yours to supply — a wrong kc1.1 gives a confidently wrong wattage.',
  },
  {
    q: 'How is drilling different from turning here?',
    a: 'In the removal rate, and it is not a small difference. A drill removes the whole cylinder it advances into, so Q = Dc × fn × Vc / 4 — which is the turning expression at a depth of cut of exactly Dc/4 and at no other value. This page told people to use turning mode for drilling until D74; that gives the right spindle speed and feed, but the removal rate and the power come out at whatever depth of cut you typed. For a 10 mm drill, entering Dc/2 doubles them and entering Dc quadruples them. Drilling and boring are now their own modes and neither asks you for a depth of cut.',
  },
  {
    q: 'Does this work offline?',
    a: 'Yes. Everything runs in your browser and nothing you enter is transmitted. Once loaded it keeps working without a connection.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Feeds and speeds calculator',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    url: `${SITE.url}/machining/feeds-and-speeds-calculator`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'Metric-first feeds and speeds for milling and turning. Spindle speed, feed in both mm/rev and mm/min, material removal rate, chip thickness and cutting power, with the formula and the substituted values shown.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Machining',
        item: `${SITE.url}/machining`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Feeds and speeds calculator',
        item: `${SITE.url}/machining/feeds-and-speeds-calculator`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const field =
  'border-line-strong bg-surface text-ink focus-visible:outline-brand rounded-control font-numeric w-full border px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2';
const label = 'text-ink-soft block text-sm font-semibold';
const hint = 'text-ink-mute mt-1 text-xs';
---

<BaseLayout
  title="Feeds and speeds calculator"
  description="Metric-first feeds and speeds for milling and turning. Spindle speed, feed in both mm/rev and mm/min, removal rate and cutting power — with the formula and every substituted value shown."
  vertical="machining"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <nav class="text-ink-mute font-mono text-xs">
      <a class="hover:text-brand underline-offset-2 hover:underline" href="/machining"
        >Machining</a
      > / Feeds and speeds
    </nav>

    <h1 class="font-display text-ink mt-3 text-4xl leading-tight font-semibold">
      Feeds and speeds
    </h1>
    <p class="text-ink-soft mt-4 max-w-prose text-lg">
      Milling and turning, treated the same. Feed in millimetres per revolution{' '}
      <em>and</em> per minute, always both. Your cutting data comes from your tooling data sheet
      — this does the arithmetic.
    </p>

    <!-- ── Calculator ──────────────────────────────────────────────────── -->
    <section class="border-line-strong bg-surface shadow-panel rounded-panel mt-8 border">
      <form id="fs-form" class="grid gap-4 p-5 sm:grid-cols-3">
        <fieldset class="sm:col-span-3">
          <legend class={label}>Operation</legend>
          <div class="mt-1 flex flex-wrap gap-4 text-sm">
            <label class="flex items-center gap-2"
              ><input type="radio" name="op" value="milling" checked /> Milling</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="op" value="turning" /> Turning</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="op" value="drilling" /> Drilling</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="op" value="boring" /> Boring</label
            >
          </div>
        </fieldset>

        <fieldset class="sm:col-span-3">
          <legend class={label}>Units</legend>
          <div class="mt-1 flex flex-wrap gap-4 text-sm">
            <label class="flex items-center gap-2"
              ><input type="radio" name="units" value="metric" checked /> Metric (m/min, mm)</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="units" value="inch" /> Inch (sfm, in)</label
            >
          </div>
        </fieldset>

        <div>
          <label class={label} for="fs-vc"
            >Cutting speed <span id="fs-vc-u">Vc</span></label
          >
          <input
            class={`${field} mt-1`}
            id="fs-vc"
            name="vc"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.1"
            value="100"
            required
          />
          <p class={hint}>From your tooling data sheet.</p>
        </div>
        <div>
          <label class={label} for="fs-dc"
            ><span id="fs-dc-label">Cutter diameter</span></label
          >
          <input
            class={`${field} mt-1`}
            id="fs-dc"
            name="dc"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.01"
            value="10"
            required
          />
          <p class={hint} id="fs-dc-hint">Tool diameter at the cut.</p>
        </div>
        <div>
          <label class={label} for="fs-fz"
            ><span id="fs-fz-label">Feed per tooth</span></label
          >
          <input
            class={`${field} mt-1`}
            id="fs-fz"
            name="fz"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.0001"
            value="0.1"
            required
          />
          <p class={hint} id="fs-fz-hint">Also from the data sheet.</p>
        </div>

        <div id="fs-teeth-wrap">
          <label class={label} for="fs-teeth">Teeth</label>
          <input
            class={`${field} mt-1`}
            id="fs-teeth"
            name="teeth"
            type="number"
            inputmode="numeric"
            step="1"
            min="1"
            value="4"
            required
          />
          <p class={hint}>Flutes or inserts.</p>
        </div>
        <div id="fs-ae-wrap">
          <label class={label} for="fs-ae">Radial depth aₑ</label>
          <input
            class={`${field} mt-1`}
            id="fs-ae"
            name="ae"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.001"
            value="5"
            required
          />
          <p class={hint}>Width of cut. Equals diameter when slotting.</p>
        </div>
        <div id="fs-d0-wrap" hidden>
          <label class={label} for="fs-d0">Starting bore d₀</label>
          <input
            class={`${field} mt-1`}
            id="fs-d0"
            name="d0"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.001"
            value="20"
          />
          <p class={hint}>The hole as it is now. The depth of cut is derived.</p>
        </div>
        <div id="fs-ap-wrap">
          <label class={label} for="fs-ap">Axial depth aₚ</label>
          <input
            class={`${field} mt-1`}
            id="fs-ap"
            name="ap"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.001"
            value="2"
            required
          />
          <p class={hint}>Depth of cut.</p>
        </div>
      </form>

      <output
        id="fs-result"
        class="border-line block border-t px-5 py-5"
        for="fs-form"
        aria-live="polite"></output>
    </section>

    <p id="fs-error" class="text-negative mt-3 hidden text-sm" role="alert"></p>

    <!-- ── Power ───────────────────────────────────────────────────────── -->
    <section class="mt-10">
      <h2 class="font-display text-ink text-2xl font-semibold">Cutting power</h2>
      <p class="text-ink-soft mt-2 max-w-prose">
        Needs two more numbers from your data sheet: the specific cutting force{' '}
        <span class="font-numeric">k<sub>c1.1</sub></span> and the Kienzle exponent{' '}
        <span class="font-numeric">m<sub>c</sub></span> for the material and grade. Without
        them any wattage would be invented, so this stays blank until you supply them.
      </p>
      <form
        id="fs-power-form"
        class="border-line bg-surface rounded-panel mt-4 grid gap-4 border p-5 sm:grid-cols-3"
      >
        <div>
          <label class={label} for="fs-kc11">k<sub>c1.1</sub> (N/mm²)</label>
          <input
            class={`${field} mt-1`}
            id="fs-kc11"
            name="kc11"
            type="number"
            inputmode="decimal"
            step="any"
            min="1"
            placeholder="e.g. 1500"
          />
        </div>
        <div>
          <label class={label} for="fs-mc">m<sub>c</sub></label>
          <input
            class={`${field} mt-1`}
            id="fs-mc"
            name="mc"
            type="number"
            inputmode="decimal"
            step="any"
            min="0"
            max="0.99"
            placeholder="e.g. 0.25"
          />
        </div>
        <div>
          <label class={label} for="fs-eta">Spindle efficiency η</label>
          <input
            class={`${field} mt-1`}
            id="fs-eta"
            name="eta"
            type="number"
            inputmode="decimal"
            step="0.05"
            min="0.1"
            max="1"
            value="0.8"
          />
          <p class={hint}>0.75–0.9 is usual.</p>
        </div>
        <div class="sm:col-span-3">
          <label class={label} for="fs-machine">Your spindle rating (kW, optional)</label>
          <input
            class={`${field} mt-1`}
            id="fs-machine"
            name="machine"
            type="number"
            inputmode="decimal"
            step="any"
            min="0.1"
            placeholder="e.g. 7.5"
          />
          <p class={hint}>
            If given, the result is compared against it. It warns; it never blocks.
          </p>
        </div>
      </form>
      <output id="fs-power" class="mt-4 block" for="fs-power-form" aria-live="polite"
      ></output>
    </section>

    <!-- ── Working ─────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">
        How this was calculated
      </h2>
      <div
        id="fs-working"
        class="border-line bg-sunken rounded-panel font-numeric mt-4 overflow-x-auto border p-4 text-sm leading-relaxed"
      >
      </div>
    </section>

    <!-- ── No material database ────────────────────────────────────────── -->
    <section class="border-caution bg-surface rounded-panel mt-12 border-l-4 p-5">
      <h2 class="font-display text-ink text-xl font-semibold">
        Why there is no material dropdown
      </h2>
      <p class="text-ink-soft mt-2 max-w-prose text-sm">
        Because cutting speed is not a property of a material. It is a property of a
        material <em>and</em> an insert substrate, a coating, an edge geometry, a coolant strategy
        and how rigid your machine is — which is why Sandvik, Kennametal and Seco publish different
        figures for the same steel, per grade.
      </p>
      <p class="text-ink-soft mt-2 max-w-prose text-sm">
        A dropdown reading “Stainless 304 → 120 m/min” would be specific, authoritative
        and wrong for most of the people who used it. The figure on the box your inserts
        came in is the right one. This page exists to do the arithmetic around it without
        errors.
      </p>
    </section>

    <!-- ── Explanation ─────────────────────────────────────────────────── -->
    <section class="text-ink-soft mt-12 max-w-prose space-y-4">
      <h2 class="font-display text-ink text-2xl font-semibold">
        The four numbers, and why they are separate
      </h2>
      <p>
        Every feeds and speeds calculation is the same short chain, and almost every
        mistake happens at one of the joins rather than in the arithmetic itself.
      </p>
      <p>
        <strong class="text-ink">Spindle speed</strong> converts a surface speed into a rotation
        rate: how fast the edge should travel through the material, divided by how far it travels
        per revolution. That is why the diameter in the formula is the <em>cutting</em> diameter
        — the tool diameter when milling, the workpiece diameter when turning. Using the wrong
        one is the single most common input error here and no formula can catch it, because
        both numbers are perfectly valid diameters.
      </p>
      <p>
        <strong class="text-ink">Feed</strong> exists in two conventions that describe the same
        motion. Feed per revolution is how far the tool advances in one turn; table feed is
        how far it advances in a minute. A lathe operator thinks in the first, a mill operator
        in the second, and converting between them requires the spindle speed you just calculated
        — which is exactly why an app showing only one of them is more annoying than it looks.
      </p>
      <p>
        <strong class="text-ink">Material removal rate</strong> is where milling and turning
        genuinely diverge. Milling sweeps a slot: radial depth times axial depth times how fast
        the table moves. Turning peels a ring: cutting speed times depth times feed per revolution.
        They are different geometries, not one formula with different labels, and apps that
        reuse the milling expression for turning produce numbers that are wrong by whatever
        the tooth count happened to be.
      </p>
      <p>
        <strong class="text-ink">Cutting power</strong> is the one that can stall a spindle,
        and the one most dependent on data this page will not invent. It scales with removal
        rate and with the specific cutting force of the material — and that force is not constant.
        Thin chips are proportionally harder to cut than thick ones, which is what the Kienzle
        exponent captures: halve the chip thickness and the force per square millimetre rises.
        A light finishing pass is not as cheap in power as its removal rate suggests.
      </p>
      <h3 class="font-display text-ink text-xl font-semibold">Chip thinning</h3>
      <p>
        When radial engagement is less than half the cutter diameter, the chip a tooth
        actually cuts is thinner than the feed per tooth you programmed. The tooth enters
        and leaves the material over a shorter arc, so the maximum thickness it reaches is
        reduced by roughly √(aₑ/Dc). Machinists exploit this deliberately — a light radial
        cut lets you raise feed per tooth substantially without overloading the edge,
        which is the whole basis of high-efficiency milling.
      </p>
      <p>
        It matters here because chip thickness feeds the power calculation. Use the
        programmed feed per tooth instead of the thinned value and the specific cutting
        force comes out too low, which understates power exactly when a light radial cut
        is tempting you to push feed.
      </p>
    </section>

    <!-- ── App ─────────────────────────────────────────────────────────── -->
    <section
      class="border-line-strong bg-surface shadow-panel rounded-panel mt-12 border p-5"
    >
      <h2 class="font-display text-ink text-xl font-semibold">
        This, on a phone that works without signal
      </h2>
      <p class="text-ink-soft mt-2 max-w-prose text-sm">
        The same arithmetic is going into a metric-first Android app, with your machines
        and materials saved so you are not re-entering them thirty times a shift. This
        page stays free either way.
      </p>
      <a
        class="text-brand mt-3 inline-block font-semibold underline underline-offset-2"
        href="/machining/app">What the app will do &rarr;</a
      >
    </section>

    <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">Common questions</h2>
      <div class="mt-4 space-y-3">
        {
          FAQ.map((item) => (
            <details class="border-line bg-surface rounded-panel border p-4">
              <summary class="text-ink cursor-pointer font-semibold">{item.q}</summary>
              <p class="text-ink-soft mt-2 max-w-prose text-sm">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ── Sources ─────────────────────────────────────────────────────── -->
    <section class="mt-12">
      <h2 class="font-display text-ink text-2xl font-semibold">Sources</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          SOURCES.map((s) => (
            <li>
              <a
                class="text-brand underline underline-offset-2"
                href={s.url}
                rel="noopener"
                target="_blank"
              >
                {s.label}
              </a>
              <span class="text-ink-mute"> — retrieved {s.retrieved}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="border-line text-ink-mute mt-10 border-t pt-4 text-sm">
      These are calculated starting figures, not a substitute for your tool manufacturer's
      recommendation. Rigidity, coolant, workholding and tool wear all move the right
      answer. Verify against your tooling supplier's data, and take a test cut.
    </p>
  </div>
</BaseLayout>

<script>
  import {
    boringDepthOfCut,
    drillingMrr,
    DEFAULT_EFFICIENCY,
    feedPerRev,
    meanChipThickness,
    millingMrr,
    removalRateFor,
    cuttingPower,
    specificCuttingForce,
    spindleSpeed,
    tableFeed,
    turningMrr,
    type UnitSystem,
  } from '../../lib/calc/feeds-speeds';
  import {
    inchToNm,
    nm,
    NM_PER_INCH,
    mmToNm,
    roundHalfEven,
    nmExactToMm,
  } from '../../lib/calc/tap-drill';

  function must<T extends HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (el === null) throw new Error(`feeds-speeds: #${id} is missing`);
    return el as T;
  }

  const form = must<HTMLFormElement>('fs-form');
  const powerForm = must<HTMLFormElement>('fs-power-form');
  const resultEl = must('fs-result');
  const powerEl = must('fs-power');
  const workingEl = must('fs-working');
  const errorEl = must('fs-error');
  const D = 4;

  const num = (f: HTMLFormElement, name: string): number =>
    Number((f.elements.namedItem(name) as HTMLInputElement).value);
  const raw = (f: HTMLFormElement, name: string): string =>
    (f.elements.namedItem(name) as HTMLInputElement).value.trim();
  const pick = (name: string): string =>
    (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;

  const toNm = (v: number, u: UnitSystem) => (u === 'metric' ? mmToNm(v) : inchToNm(v));
  const fromNm = (v: number, u: UnitSystem) =>
    u === 'metric' ? v / 1_000_000 : v / NM_PER_INCH;
  const lenUnit = (u: UnitSystem) => (u === 'metric' ? 'mm' : 'in');

  /**
   * Which fields an operation actually has.
   *
   * Only milling has a tooth count and a radial width of cut. Only milling and
   * turning have a depth of cut you enter: drilling's is fixed by the drill,
   * and boring's is derived from the two diameters, which is the point of
   * asking for both — see D74.
   */
  const DIAMETER_LABEL: Record<string, [string, string]> = {
    milling: ['Cutter diameter', 'Tool diameter at the cut.'],
    turning: ['Workpiece diameter', 'Diameter at the cut, not the stock size.'],
    drilling: ['Drill diameter', 'The hole the drill produces.'],
    boring: ['Final bore d₁', 'The hole this pass produces. Vc applies here.'],
  };

  function relabel(): void {
    const op = pick('op');
    const u = pick('units') as UnitSystem;
    must('fs-vc-u').textContent = u === 'metric' ? 'Vc (m/min)' : 'Vc (sfm)';

    const [dcLabel, dcHint] = DIAMETER_LABEL[op] ?? DIAMETER_LABEL.milling!;
    must('fs-dc-label').textContent = dcLabel;
    must('fs-dc-hint').textContent = dcHint;

    must('fs-fz-label').innerHTML =
      op === 'milling'
        ? 'Feed per tooth f<sub>z</sub>'
        : 'Feed per revolution f<sub>n</sub>';

    must('fs-teeth-wrap').hidden = op !== 'milling';
    must('fs-ae-wrap').hidden = op !== 'milling';
    must('fs-ap-wrap').hidden = op === 'drilling' || op === 'boring';
    must('fs-d0-wrap').hidden = op !== 'boring';
  }

  function render(): void {
    relabel();
    errorEl.classList.add('hidden');
    try {
      const u = pick('units') as UnitSystem;
      const op = pick('op');
      const milling = op === 'milling';
      const vc = num(form, 'vc');
      const dcNm = toNm(num(form, 'dc'), u);
      const rpm = spindleSpeed(vc, dcNm, u);

      // Only milling derives feed per revolution from a tooth count; every
      // other operation is given fn directly, which is how their data sheets
      // and their machine controls are both written.
      const fzNm = toNm(num(form, 'fz'), u);
      const fnNm = milling ? feedPerRev(fzNm, num(form, 'teeth')) : fzNm;
      const vfNm = tableFeed(fnNm, rpm);
      const aeNm = milling ? toNm(num(form, 'ae'), u) : dcNm;

      // The depth of cut, per operation.
      //
      // Drilling has none to enter — the drill fixes it — and the value used
      // here is Dc/4, which is not a placeholder: the derivation in
      // `drillingMrr` shows drilling IS turning at exactly that depth. Boring's
      // is derived from the two diameters so it cannot be entered doubled (D74).
      const apNm =
        op === 'drilling'
          ? nm(Math.round(dcNm / 4))
          : op === 'boring'
            ? boringDepthOfCut(toNm(num(form, 'd0'), u), dcNm)
            : toNm(num(form, 'ap'), u);

      // Every removal rate here is cm³/min whatever the user typed, because
      // Nanometres carry no unit system and the formulas are metric. `mrrCm3`
      // is what the power arithmetic needs; `rate` is what the panel shows.
      const mrrCm3 =
        op === 'milling'
          ? millingMrr(aeNm, apNm, vfNm)
          : op === 'drilling'
            ? drillingMrr(vc, dcNm, fnNm, u)
            : turningMrr(vc, apNm, fnNm, u);

      // The value and its unit come back together so they cannot disagree.
      // They did disagree: this page used to pick an `in³/min` label to stand
      // beside an unconverted cm³/min number, and hand surface feet per minute
      // to functions that require m/min — 16.387064× too high for milling,
      // 53.7633× for the other three, with nothing on screen to suggest it.
      const rate = removalRateFor(mrrCm3, u);

      const hmNm = milling ? meanChipThickness(fzNm, aeNm, dcNm) : fnNm;

      const L = lenUnit(u);
      const feedMin = u === 'metric' ? 'mm/min' : 'in/min';
      const feedRev = u === 'metric' ? 'mm/rev' : 'in/rev';
      const stat = (k: string, v: string, s: string) =>
        `<div><p class="font-mono text-xs uppercase tracking-widest text-ink-mute">${k}</p>
         <p class="mt-1 font-numeric text-2xl font-semibold text-ink">${v}</p>
         <p class="text-sm text-ink-mute">${s}</p></div>`;

      resultEl.innerHTML = `<div class="grid gap-4 sm:grid-cols-3">
        ${stat('Spindle speed', `${roundHalfEven(rpm, 0)}`, 'rev/min')}
        ${stat('Feed', `${roundHalfEven(fromNm(vfNm, u), D)}`, feedMin)}
        ${stat('Feed per rev', `${roundHalfEven(fromNm(fnNm, u), D)}`, feedRev)}
        ${stat('Removal rate', `${roundHalfEven(rate.value, D)}`, rate.unit)}
        ${stat(milling ? 'Mean chip (approx)' : 'Chip thickness', `${roundHalfEven(fromNm(hmNm, u), D)}`, L)}
      </div>`;

      const show = (v: number) => roundHalfEven(fromNm(v, u), D);
      const metric = u === 'metric';
      // The derivation quotes the panel's own rendered figure rather than
      // rounding a second time, so the two cannot disagree on a decimal.
      const q = `${roundHalfEven(rate.value, D)} ${rate.unit}`;
      workingEl.textContent =
        `n  = ${u === 'metric' ? 'Vc × 1000' : 'Vc × 12'} / (π × Dc)\n` +
        `   = ${u === 'metric' ? `${vc} × 1000` : `${vc} × 12`} / (π × ${show(dcNm)} ${L})\n` +
        `   = ${roundHalfEven(rpm, 4)} rev/min\n\n` +
        (milling
          ? `fn = fz × z = ${show(fzNm)} × ${num(form, 'teeth')} = ${show(fnNm)} ${feedRev}\n`
          : `fn = ${show(fnNm)} ${feedRev}   (entered)\n`) +
        `vf = fn × n = ${show(fnNm)} × ${roundHalfEven(rpm, 2)} = ${show(vfNm)} ${feedMin}\n\n` +
        // Metric and inch are genuinely different equations here, not one
        // equation with the numbers swapped: metric divides mm³ down to cm³,
        // inch multiplies surface FEET per minute up to inches per minute. A
        // derivation showing the metric form to an inch user teaches arithmetic
        // that does not reproduce the answer above it — which is what this box
        // did, printing `0.25 × 0.1 × 24.4462 / 1000 = 10.015 in³/min` where
        // the left-hand side evaluates to 0.00061.
        (op === 'milling'
          ? metric
            ? `Q  = ae × ap × vf / 1000 = ${show(aeNm)} × ${show(apNm)} × ${show(vfNm)} / 1000 = ${q}\n`
            : `Q  = ae × ap × vf = ${show(aeNm)} × ${show(apNm)} × ${show(vfNm)} = ${q}\n`
          : op === 'drilling'
            ? (metric
                ? `Q  = Dc × fn × Vc / 4 = ${show(dcNm)} × ${show(fnNm)} × ${vc} / 4 = ${q}\n`
                : `Q  = Dc × fn × Vc × 12 / 4 = ${show(dcNm)} × ${show(fnNm)} × ${vc} × 12 / 4 = ${q}\n`) +
              `     a drill removes the whole cylinder, not a swept slot\n`
            : (op === 'boring'
                ? `ap = (d₁ − d₀) / 2 = derived, ${show(apNm)} ${L}\n`
                : '') +
              (metric
                ? `Q  = Vc × ap × fn = ${vc} × ${show(apNm)} × ${show(fnNm)} = ${q}\n`
                : `Q  = Vc × 12 × ap × fn = ${vc} × 12 × ${show(apNm)} × ${show(fnNm)} = ${q}\n`)) +
        (milling
          ? `\nhm ≈ fz × √(ae/Dc) = ${show(fzNm)} × √(${show(aeNm)}/${show(dcNm)}) = ${show(hmNm)} ${L}   (approximate)\n`
          : '');

      // Power takes the cm³/min figure, never the displayed one: Kienzle's kc
      // is N/mm² and the 60000 in Pc is dimensioned for cm³/min.
      renderPower(mrrCm3, hmNm, u, milling);
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Check the inputs.';
      errorEl.classList.remove('hidden');
      resultEl.innerHTML = '';
      workingEl.textContent = '';
      powerEl.innerHTML = '';
    }
  }

  /**
   * Power from the removal rate the operation actually has.
   *
   * It used to take ae, ap and vf and hand them to `millingPower`, which
   * recomputes the MILLING removal rate from them. Turning passed Dc as ae, so
   * the power was computed from `Dc × ap × vf / 1000` rather than `Vc × ap ×
   * fn` — understating it by exactly π. See D75.
   */
  function renderPower(mrr: number, hmNm: number, u: UnitSystem, thinned: boolean): void {
    const kc11 = raw(powerForm, 'kc11');
    const mc = raw(powerForm, 'mc');
    if (kc11 === '' || mc === '') {
      powerEl.innerHTML = `<p class="text-ink-mute text-sm">Enter k<sub>c1.1</sub> and m<sub>c</sub> from your tooling data to see cutting power. Nothing is assumed for you.</p>`;
      return;
    }
    if (u === 'inch') {
      powerEl.innerHTML = `<p class="text-caution text-sm">Kienzle constants are published in metric (N/mm²). Switch the units above to metric for the power figure.</p>`;
      return;
    }
    try {
      const eta = num(powerForm, 'eta') || DEFAULT_EFFICIENCY;
      const kc = specificCuttingForce(Number(kc11), Number(mc), hmNm);
      const pc = cuttingPower(mrr, kc, eta);
      const machine = raw(powerForm, 'machine');
      let verdict = '';
      if (machine !== '') {
        const rated = Number(machine);
        const pct = (pc / rated) * 100;
        const tone =
          pct > 90 ? 'text-negative' : pct > 70 ? 'text-caution' : 'text-positive';
        verdict = `<p class="mt-2 text-sm ${tone}">${roundHalfEven(pct, 1)}% of your ${rated} kW spindle.${
          pct > 90 ? ' That is not a cut to take without reducing something.' : ''
        }</p>`;
      }
      powerEl.innerHTML = `<div class="border-line bg-surface rounded-panel border p-4">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-mute">Net cutting power</p>
        <p class="mt-1 font-numeric text-3xl font-semibold text-brand">${roundHalfEven(pc, 3)} kW</p>
        <p class="text-ink-mute mt-1 text-sm">kc = ${roundHalfEven(kc, 1)} N/mm² at ${roundHalfEven(nmExactToMm(hmNm), 4)} mm chip${
          thinned ? ' (thinned)' : ''
        }</p>${verdict}
      </div>`;
    } catch (err) {
      powerEl.innerHTML = `<p class="text-negative text-sm">${
        err instanceof Error ? err.message : 'Check the power inputs.'
      }</p>`;
    }
  }

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  powerForm.addEventListener('input', render);
  render();
</script>
