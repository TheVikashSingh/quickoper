---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import ToolRow from '../../components/ToolRow.astro';
import { QuickCost } from '../../components/calculators/QuickCost';
import ProofChart from '../../components/ornament/ProofChart.astro';
import { SITE } from '../../lib/site';
import { compareStrategies } from '../../lib/calc/debt-payoff';
import { format, fromMajor } from '../../lib/calc/money';
import { derivationsIn, toolsIn } from '../../lib/catalogue';

/**
 * THE TEASER AND THE PROOF LIVE HERE NOW, NOT ON THE ROOT (D91).
 *
 * D34 put an island on the homepage and D32 put a computed payoff curve beside
 * it, both on sound reasoning: a visitor who types a number into a box has
 * engaged, and a page that proves beats a page that claims. Both were decided
 * when finance was the only vertical, so "the landing page" and "the money
 * landing page" were the same page. They stopped being the same page on
 * 2026-09-01 and nobody moved these.
 *
 * The reasoning is untouched — it is simply applied to the right page. This is
 * where a visitor who wants money tools arrives, so this is where the box to
 * type in and the curve that proves the engine belong.
 *
 * THE FIGURES ARE COMPUTED, NOT WRITTEN. This runs the real engine at build
 * time on the calculator's own default scenario, so the hub cannot claim a
 * saving the product does not produce and cannot go stale when the engine
 * changes. It is zero client JavaScript — .astro frontmatter never reaches the
 * browser.
 */
const DEMO_DEBTS = [
  {
    id: 'd1',
    name: 'Store card',
    balance: fromMajor(900),
    annualRate: 0.2999,
    minimumPayment: fromMajor(30),
  },
  {
    id: 'd2',
    name: 'Credit card',
    balance: fromMajor(6000),
    annualRate: 0.2299,
    minimumPayment: fromMajor(150),
  },
  {
    id: 'd3',
    name: 'Personal loan',
    balance: fromMajor(2500),
    annualRate: 0.0699,
    minimumPayment: fromMajor(120),
  },
];

const DEMO_BUDGET = fromMajor(600);
const demo = compareStrategies(DEMO_DEBTS, DEMO_BUDGET);

const opening = DEMO_DEBTS.reduce((sum, d) => sum + d.balance, 0);
const curve = (result: (typeof demo)['avalanche']) => [
  opening,
  ...result.schedule.map((m) => m.totalRemaining),
];

const CURRENCY = 'USD';

/**
 * THE SCENARIO DESCRIBES ITSELF (D55).
 *
 * "$9,400 of debt, $600 a month" was typed into two places on this page while
 * the actual balances lived in DEMO_DEBTS above. Editing a demo balance would
 * have left the caption stating a total the chart beside it no longer showed —
 * the same failure as "paying $150 instead of $250 removes 44 months": a true
 * number, a false sentence, and nothing able to tell.
 */
const totalOwed = format(opening as typeof DEMO_BUDGET, CURRENCY);
const monthlyBudget = format(DEMO_BUDGET, CURRENCY);

const saved = format(demo.interestSavedVsMinimums, CURRENCY);
const monthsSaved = demo.monthsSavedVsMinimums;
const fastMonths = demo.avalanche.months;
const slowMonths = demo.minimumsOnly.months;

// The cluster hub. Hub-and-spoke internal linking is the main mechanism a new
// site has for concentrating topical relevance: every tool links up to here,
// and this page links back down to every tool.
//
// BOTH LISTS COME FROM src/lib/catalogue.ts AND NEITHER IS WRITTEN OUT HERE.
// The derivations were a hand-maintained array of six, and by the time it was
// replaced the site had eight — `/15-year-vs-30-year-mortgage` and
// `/mortgage-overpayment-timing` had shipped weeks earlier and neither ever
// reached this page. That is the fourth time a page has existed without
// appearing where something looks for it (D41, D50, D61), and the first three
// were each fixed by hand. A hub that renders from the registry cannot omit a
// page, because there is no second list to forget.
//
// The "in progress" list is honest about what is coming rather than shipping
// empty stub pages for it — empty categories are an explicit AdSense rejection
// reason.

const TOOLS = toolsIn('finance');
const DERIVATIONS = derivationsIn('finance');

const IN_PROGRESS = ['Freelance and contractor rate'];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: `${SITE.url}/finance`,
    name: 'Money calculators',
    hasPart: TOOLS.map((tool) => ({
      '@type': 'WebApplication',
      name: tool.title,
      applicationCategory: 'FinanceApplication',
      url: `${SITE.url}${tool.href}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Money calculators',
        item: `${SITE.url}/finance`,
      },
    ],
  },
];
---

<BaseLayout
  vertical="finance"
  title="Money calculators that show their working | QuickOper"
  description="Free money calculators that give you the whole schedule, prove their arithmetic against published figures, and never send anything you type to a server."
  structuredData={structuredData}
>
  <h1 class="text-3xl font-semibold tracking-tight">Money calculators</h1>

  <p class="text-ink-soft mt-3 text-lg">
    Each one gives you the formula, every period of the schedule, and a result you can
    export or print. Every calculation runs in your browser.
  </p>

  <ToolRow
    class="mt-6"
    vertical="finance"
    extra={{ href: '/finance/verify', label: 'Check our arithmetic' }}
  />

  <section class="mt-8" aria-labelledby="quick-heading">
    <div class="rounded-panel border-line-strong bg-surface border p-1.5">
      <div class="border-engrave-strong rounded-control border p-4 sm:p-6">
        <p class="engraved-fine text-ink-mute">Try it now</p>
        <h2 id="quick-heading" class="text-ink mt-1 text-xl font-semibold sm:text-2xl">
          What is a debt actually costing you?
        </h2>

        <div class="mt-5">
          <QuickCost client:load>
            <Fragment slot="privacy">
              Worked out in your browser. Nothing you type is sent anywhere, and nothing
              is saved.
            </Fragment>
          </QuickCost>
        </div>
      </div>
    </div>
  </section>

  {
    /* Proof, computed at build time by the real engine on the calculator`s own
      default scenario — see the frontmatter (D32). */
  }
  <section class="mt-10" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="sr-only">What the debt payoff calculator produces</h2>

    <div class="rounded-panel border-line-strong bg-surface border p-1.5">
      <div class="border-engrave-strong rounded-control border p-4 sm:p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="engraved text-ink text-xs">
            {totalOwed} of debt, {monthlyBudget} a month
          </p>
          <p class="text-ink-mute text-xs">
            Worked out in your browser · nothing transmitted
          </p>
        </div>

        <ProofChart
          class="mt-4"
          caption={`Total balance by month. Paying ${monthlyBudget} a month with the avalanche method clears ${totalOwed} of debt in ${fastMonths} months. Paying only the minimums takes ${slowMonths} months and costs ${saved} more in interest.`}
          series={[
            { label: 'Minimum payments only', points: curve(demo.minimumsOnly) },
            { label: 'Avalanche', points: curve(demo.avalanche), emphasis: true },
          ]}
        />

        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Debt-free in</dt>
            <dd class="numeric text-ink mt-0.5 text-xl font-semibold">
              {fastMonths} months
            </dd>
            <dd class="text-ink-mute text-xs">instead of {slowMonths}</dd>
          </div>
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Interest saved</dt>
            <dd class="numeric text-positive mt-0.5 text-xl font-semibold">{saved}</dd>
            <dd class="text-ink-mute text-xs">against paying minimums</dd>
          </div>
          <div>
            <dt class="engraved text-ink-mute text-[0.65rem]">Sooner by</dt>
            <dd class="numeric text-ink mt-0.5 text-xl font-semibold">
              {monthsSaved} months
            </dd>
            <dd class="text-ink-mute text-xs">
              <a class="text-brand underline" href="/finance/debt-payoff-calculator">
                run your own figures
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="text-ink-mute mt-2 text-xs">
      Every figure above is produced by the calculator itself when this page is built —
      not written by hand.
    </p>
  </section>

  <h2 class="section-head mt-12">Every money tool</h2>

  <ul class="mt-6 space-y-4">
    {
      TOOLS.map((tool) => (
        <li>
          <ToolCard
            href={tool.href}
            title={tool.title}
            summary={tool.summary}
            detail={tool.detail}
            size="lg"
          />
        </li>
      ))
    }
  </ul>

  {
    /*
      The derivations belong on the hub, not only on the homepage.

      Measured inbound links before this section existed: /coast-number 1,
      /withdrawal-rate 2, /credit-card-interest 3 — against /terms 16 and
      /contact 22 (D53). The hub said "every tool links up to here, and this
      page links back down to every tool", and it was true of the tools and
      false of everything that explains them.

      These pages are the long-tail surface. A hub that lists only the three
      tools tells a crawler this cluster is three pages wide.
    */
  }
  <section class="mt-12">
    <h2 class="text-lg font-semibold">The arithmetic behind them</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Each one works a single calculation out from first principles, with real figures
      computed by the same engines the tools run.
    </p>
    <ul class="mt-4 space-y-3">
      {
        DERIVATIONS.map((page) => (
          <li>
            <a class="text-brand underline" href={page.href}>
              {page.title}
            </a>
            <span class="text-ink-soft text-sm"> — {page.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">Being built</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Tools are added one at a time, each with its arithmetic tested against a published
      figure before it ships. Nothing appears here until it is finished and checked.
    </p>
    <ul class="text-ink-mute mt-3 list-disc space-y-1 pl-5 text-sm">
      {IN_PROGRESS.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="border-line mt-12 border-t pt-6">
    <h2 class="text-lg font-semibold">How to know these numbers are right</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Every calculation is a tested function checked against published third-party
      figures, and the tests are public. The{' '}
      <a class="text-brand underline" href="/methodology">methodology page</a> sets out the
      rounding policy, the verification approach, and a worked example you can repeat yourself.
    </p>
  </section>
</BaseLayout>
