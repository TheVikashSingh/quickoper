---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { SITE } from '../../lib/site';

// The cluster hub. Hub-and-spoke internal linking is the main mechanism a new
// site has for concentrating topical relevance: every tool links up to here,
// and this page links back down to every tool.
//
// One entry today. Adding a tool is one line, and the "in progress" list is
// honest about what is coming rather than shipping empty stub pages for it —
// empty categories are an explicit AdSense rejection reason.

const TOOLS = [
  {
    href: '/finance/debt-payoff-calculator',
    title: 'Debt payoff — avalanche vs snowball',
    summary:
      'Compare both methods against paying only the minimums. Full month-by-month schedule, chart, spreadsheet and printable PDF.',
    detail: 'Works in any currency. No jurisdiction rules involved.',
  },
  {
    href: '/finance/mortgage-overpayment-calculator',
    title: 'Mortgage overpayment — what paying extra removes',
    summary:
      'See exactly what an extra monthly payment takes off a mortgage, in months and in interest. Full schedule, chart, spreadsheet and printable PDF.',
    detail:
      'US fixed-rate convention. The required payment matches the published figure to the cent.',
  },
  {
    href: '/finance/coast-fire-calculator',
    title: 'Coast FIRE — when saving becomes optional',
    summary:
      'How much you need invested today for it to reach your retirement target on its own. Year-by-year projection, chart, spreadsheet and printable PDF.',
    detail: 'Everything in today’s money. Works in any currency.',
  },
];

const DERIVATIONS = [
  {
    href: '/minimum-payments',
    title: 'How long minimum payments take, and when they never finish',
    summary:
      'the one line that decides whether a card ever clears, and the balances where it does not',
  },
  {
    href: '/biweekly-mortgage-payments',
    title: 'Biweekly mortgage payments: what the thirteenth payment does',
    summary:
      'why 26 half-payments is 13 monthly ones, and what that one extra payment removes',
  },
  {
    href: '/credit-card-interest',
    title: 'How credit card interest is actually calculated',
    summary: 'the daily periodic rate, and why 22.99% costs 25.838%',
  },
  {
    href: '/monthly-return-rate',
    title: 'Why a 7% return is not 0.583% a month',
    summary: 'one division that overstates thirty years by $50,424',
  },
  {
    href: '/withdrawal-rate',
    title: 'Where the 4% rule comes from',
    summary: 'what Bengen and the Trinity Study actually tested, and what they did not',
  },
  {
    href: '/coast-number',
    title: 'What a coast number is, and what it is not',
    summary: 'the assumption that moves the figure more than any other',
  },
];

const IN_PROGRESS = ['Freelance and contractor rate'];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: `${SITE.url}/finance`,
    name: 'Money calculators',
    hasPart: TOOLS.map((tool) => ({
      '@type': 'WebApplication',
      name: tool.title,
      applicationCategory: 'FinanceApplication',
      url: `${SITE.url}${tool.href}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Calculators',
        item: `${SITE.url}/finance`,
      },
    ],
  },
];
---

<BaseLayout
  title="Money calculators that show their working | QuickOper"
  description="Free money calculators that give you the whole schedule, prove their arithmetic against published figures, and never send anything you type to a server."
  structuredData={structuredData}
>
  <h1 class="text-3xl font-semibold tracking-tight">Money calculators</h1>

  <p class="text-ink-soft mt-3 text-lg">
    Each one gives you the formula, every period of the schedule, and a result you can
    export or print. Every calculation runs in your browser.
  </p>

  <ul class="mt-8 space-y-4">
    {
      TOOLS.map((tool) => (
        <li>
          <ToolCard
            href={tool.href}
            title={tool.title}
            summary={tool.summary}
            detail={tool.detail}
            size="lg"
          />
        </li>
      ))
    }
  </ul>

  {
    /*
      The derivations belong on the hub, not only on the homepage.

      Measured inbound links before this section existed: /coast-number 1,
      /withdrawal-rate 2, /credit-card-interest 3 — against /terms 16 and
      /contact 22 (D53). The hub said "every tool links up to here, and this
      page links back down to every tool", and it was true of the tools and
      false of everything that explains them.

      These pages are the long-tail surface. A hub that lists only the three
      tools tells a crawler this cluster is three pages wide.
    */
  }
  <section class="mt-12">
    <h2 class="text-lg font-semibold">The arithmetic behind them</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Each one works a single calculation out from first principles, with real figures
      computed by the same engines the tools run.
    </p>
    <ul class="mt-4 space-y-3">
      {
        DERIVATIONS.map((page) => (
          <li>
            <a class="text-brand underline" href={page.href}>
              {page.title}
            </a>
            <span class="text-ink-soft text-sm"> — {page.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">Being built</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Tools are added one at a time, each with its arithmetic tested against a published
      figure before it ships. Nothing appears here until it is finished and checked.
    </p>
    <ul class="text-ink-mute mt-3 list-disc space-y-1 pl-5 text-sm">
      {IN_PROGRESS.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="border-line mt-12 border-t pt-6">
    <h2 class="text-lg font-semibold">How to know these numbers are right</h2>
    <p class="text-ink-soft mt-2 text-sm">
      Every calculation is a tested function checked against published third-party
      figures, and the tests are public. The{' '}
      <a class="text-brand underline" href="/methodology">methodology page</a> sets out the
      rounding policy, the verification approach, and a worked example you can repeat yourself.
    </p>
  </section>
</BaseLayout>
