---
import { existsSync } from 'node:fs';
import '../styles/global.css';
import LatheBand from '../components/ornament/LatheBand.astro';
import Rosette from '../components/ornament/Rosette.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Omit to derive from the current URL. */
  canonical?: string | undefined;
  /** Set true until the site is ready to be indexed (see charter §13). */
  noindex?: boolean | undefined;
  /** Extra JSON-LD nodes for the page (WebApplication, BreadcrumbList, ...). */
  structuredData?: Record<string, unknown>[] | undefined;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

/**
 * The entity graph — Organization, Person and WebSite, on every page.
 *
 * These are site-wide E-E-A-T signals, not decoration. CLAUDE.md has required
 * `Organization + Person (author, with sameAs)` since the beginning; only
 * Organization was ever emitted, and it had no `sameAs` either. For a
 * Your-Money-Your-Life site that is the expensive omission: a search engine
 * cannot attach credibility to an author it cannot resolve to an entity, and
 * "who wrote this and can it be verified" is the first question asked of
 * financial content from an unknown domain.
 *
 * `@id` and cross-references matter more than the individual nodes. A bare
 * Person floating beside a bare Organization is two orphans; linking them with
 * `founder`, `publisher` and `author` is what makes them one graph that a
 * consumer — Google or a retrieval system — can actually traverse.
 *
 * THE CLAIM IS COMPUTATIONAL, NOT ADVISORY, and `knowsAbout` says so. Claiming
 * financial expertise here would be false and is exactly what D1 forbids.
 */
const personId = `${SITE.url}/about#person`;
const orgId = `${SITE.url}#organization`;

/**
 * The author photograph, if it has been committed yet.
 *
 * `image` on the Person node is what a search engine and a retrieval system
 * read for "is there a real, identifiable human behind this". Included only
 * when the file actually exists, so this ships safely before the photo does —
 * an entity claiming an image that 404s is worse than one claiming none.
 */
const AUTHOR_PHOTO = '/author.jpg';
const hasAuthorPhoto = existsSync(`public${AUTHOR_PHOTO}`);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: SITE.author.name,
  url: `${SITE.url}/about`,
  ...(hasAuthorPhoto ? { image: `${SITE.url}${AUTHOR_PHOTO}` } : {}),
  // The only identity claims that can be verified by following a link. No
  // invented credentials, no fabricated profiles.
  sameAs: [SITE.author.github],
  jobTitle: 'Software engineer',
  knowsAbout: [
    'Deterministic financial arithmetic',
    'Amortisation schedules',
    'Compound interest',
    'Rounding policy in currency calculations',
  ],
  description:
    'Software engineer, not a financial adviser. Builds and verifies the calculation engines behind QuickOper; the expertise claimed is computational rather than advisory.',
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': orgId,
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  founder: { '@id': personId },
  sameAs: [SITE.repo],
  description:
    'Verified-calculation tools for personal money decisions. Every calculation runs in the browser; nothing is transmitted.',
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.tagline,
  publisher: { '@id': orgId },
  inLanguage: 'en',
};

const graph = [organization, person, website, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />

    {
      /*
      `summary`, not `summary_large_image`. Every page declared the large-image
      card and no page supplied an og:image, so the card rendered as an empty
      grey box everywhere the site was shared — announcing a picture and then
      failing to produce one is worse than not asking for the slot.

      Turning it back on needs a real raster asset. SVG is not accepted by the
      card renderers, and generating a PNG at build time means satori or sharp,
      which is a dependency against CLAUDE.md rule 4 for a social preview. The
      cheap route is one hand-made 1200x630 PNG committed to public/ — recorded
      in STATE.md as an operator task rather than left as a silent defect.
    */
    }
    <meta name="twitter:card" content="summary" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      graph.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
      ))
    }

    {
      /*
      Applies a stored theme choice BEFORE first paint. It has to be inline and
      blocking: anything deferred lets the wrong theme render for a frame, and
      a white flash on a dark-theme page is worse than no toggle at all.

      Reads localStorage but never writes here — only an explicit click does
      that (CLAUDE.md: nothing in storage the user has not chosen to save).
    */
    }
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('qo-theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* private mode, storage disabled — fall through to system preference */
        }
      })();
    </script>
  </head>

  <body class="bg-canvas text-ink min-h-dvh antialiased">
    <a
      href="#main"
      class="focus:rounded-control focus:bg-brand sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    {
      /*
      The masthead is laid out as the head of a note: a lathe band across the
      full width, then the wordmark and navigation inside a ruled field, then a
      second band closing it. Two rules of different weight rather than one —
      that is what separates an engraved document from a card with a border.

      All build-time SVG, so content pages still ship 0.53KB of JavaScript: the
      inline theme script and nothing else.
    */
    }
    <header class="bg-masthead text-masthead-ink border-brand border-b-2">
      <LatheBand height={10} class="text-masthead-line" />

      <nav
        class="mx-auto flex max-w-4xl items-center gap-4 px-4 py-3.5"
        aria-label="Primary"
      >
        <a href="/" class="group flex items-center gap-2.5" aria-label="QuickOper home">
          <Rosette
            size={26}
            petals={14}
            class="text-masthead-accent hidden shrink-0 opacity-80 sm:block"
          />
          {
            /* One word in two colours. data-tight tells the spacing checker
              this adjacency is deliberate. */
          }
          <span class="leading-none">
            <span class="engraved text-masthead-ink block text-base sm:text-lg">
              Quick<span class="text-masthead-accent" data-tight>Oper</span>
            </span>
            {
              /* The name is a contraction of "quickly operate". Stated in the
                masthead because an unexplained coinage reads as arbitrary, and
                nothing else on this site is. */
            }
            <span class="engraved-fine text-masthead-mute mt-0.5 block">
              {SITE.strapline}
            </span>
          </span>
        </a>

        <ul class="text-masthead-mute ml-auto flex items-center gap-5 text-sm">
          <li>
            <a class="hover:text-masthead-ink" href="/finance">Calculators</a>
          </li>
          <li>
            <a class="hover:text-masthead-ink hidden sm:inline" href="/methodology">
              Methodology
            </a>
          </li>
          <li><a class="hover:text-masthead-ink" href="/about">About</a></li>
        </ul>

        <button
          id="theme-toggle"
          type="button"
          class="border-masthead-mute hover:border-masthead-accent hover:text-masthead-ink text-masthead-mute rounded-control -mr-1 border p-1.5"
          aria-label="Switch theme"
          aria-pressed="false"
        >
          {
            /* Both icons ship; CSS shows whichever matches the active theme, so
              the button is correct on first paint with no scripting. */
          }
          <svg
            class="theme-icon-light h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="theme-icon-dark h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-4xl px-4 py-10">
      <slot />
    </main>

    {/* The band closes the note at the foot as it opened it at the head. */}
    <footer class="bg-masthead text-masthead-mute border-brand mt-16 border-t-2">
      <LatheBand height={10} class="text-masthead-line" />

      <div class="mx-auto max-w-4xl px-4 py-8 text-sm">
        {
          /* The line a note carries under its scrollwork. Engraved caps, set
            small — it states what the site is, in the voice of the thing it
            is imitating, without imitating anything specific. */
        }
        <p class="engraved-fine text-masthead-mute mb-4 flex items-center gap-3">
          {
            /* Decorative rules either side. Flex `gap-3` does the spacing, so a
            literal space here would be meaningless — data-tight tells the
            spacing checker the adjacency is deliberate (D24). */
          }
          <span class="bg-masthead-line h-px flex-1" data-tight></span>
          Computed, not advised
          <span class="bg-masthead-line h-px flex-1" data-tight></span>
        </p>
        <p class="mb-3">
          QuickOper computes; it does not advise. Nothing here is financial, tax or
          investment advice. Every calculation runs entirely in your browser — nothing you
          type is transmitted or stored.
        </p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          <li>
            <a class="hover:text-masthead-ink" href="/methodology">How we verify</a>
          </li>
          <li><a class="hover:text-masthead-ink" href="/privacy">Privacy</a></li>
          <li><a class="hover:text-masthead-ink" href="/terms">Terms</a></li>
          <li><a class="hover:text-masthead-ink" href="/contact">Contact</a></li>
        </ul>
      </div>
    </footer>

    {
      /*
      The toggle. Inline and dependency-free so content pages stay at zero
      module JavaScript — a theme switch is not worth hydrating a framework for.

      localStorage is written ONLY on click. A theme is something the visitor
      explicitly chose, which is exactly the exception CLAUDE.md allows; storing
      one they never asked for would not be.
    */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;

        function active() {
          return (
            root.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          );
        }

        function label(theme) {
          btn.setAttribute(
            'aria-label',
            theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
          );
          btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }

        label(active());

        btn.addEventListener('click', function () {
          var next = active() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('qo-theme', next);
          } catch (e) {
            /* storage unavailable — the choice still applies for this page */
          }
          label(next);
        });
      })();
    </script>
  </body>
</html>
