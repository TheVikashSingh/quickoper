---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Omit to derive from the current URL. */
  canonical?: string | undefined;
  /** Set true until the site is ready to be indexed (see charter §13). */
  noindex?: boolean | undefined;
  /** Extra JSON-LD nodes for the page (WebApplication, BreadcrumbList, ...). */
  structuredData?: Record<string, unknown>[] | undefined;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Organization and Person are site-wide E-E-A-T signals, not decoration.
// The expertise claimed here is computational, not advisory — stated honestly.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'QuickOper',
  url: 'https://quickoper.com',
  description:
    'Verified-calculation tools for personal money decisions. Every calculation runs in the browser; nothing is transmitted.',
};

const graph = [organization, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="QuickOper" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      graph.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
      ))
    }

    {
      /*
      Applies a stored theme choice BEFORE first paint. It has to be inline and
      blocking: anything deferred lets the wrong theme render for a frame, and
      a white flash on a dark-theme page is worse than no toggle at all.

      Reads localStorage but never writes here — only an explicit click does
      that (CLAUDE.md: nothing in storage the user has not chosen to save).
    */
    }
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('qo-theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* private mode, storage disabled — fall through to system preference */
        }
      })();
    </script>
  </head>

  <body class="bg-canvas text-ink min-h-dvh antialiased">
    <a
      href="#main"
      class="focus:rounded-control focus:bg-brand sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="border-line bg-surface border-b">
      <nav
        class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-3.5"
        aria-label="Primary"
      >
        <a
          href="/"
          class="font-display text-ink text-xl font-semibold"
          aria-label="QuickOper home"
        >
          Quick<span class="text-brand">Oper</span>
        </a>

        <ul class="text-ink-soft ml-auto flex items-center gap-5 text-sm">
          <li><a class="hover:text-ink" href="/finance">Calculators</a></li>
          <li>
            <a class="hover:text-ink hidden sm:inline" href="/methodology">Methodology</a>
          </li>
          <li><a class="hover:text-ink" href="/about">About</a></li>
        </ul>

        <button
          id="theme-toggle"
          type="button"
          class="border-line hover:border-line-strong hover:bg-sunken text-ink-soft rounded-control -mr-1 border p-1.5"
          aria-label="Switch theme"
          aria-pressed="false"
        >
          {
            /* Both icons ship; CSS shows whichever matches the active theme, so
              the button is correct on first paint with no scripting. */
          }
          <svg
            class="theme-icon-light h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="theme-icon-dark h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-line mt-16 border-t">
      <div class="text-ink-mute mx-auto max-w-3xl px-4 py-8 text-sm">
        <p class="mb-3">
          QuickOper computes; it does not advise. Nothing here is financial, tax or
          investment advice. Every calculation runs entirely in your browser — nothing you
          type is transmitted or stored.
        </p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          <li><a class="hover:text-ink" href="/methodology">How we verify</a></li>
          <li><a class="hover:text-ink" href="/privacy">Privacy</a></li>
          <li><a class="hover:text-ink" href="/terms">Terms</a></li>
          <li><a class="hover:text-ink" href="/contact">Contact</a></li>
        </ul>
      </div>
    </footer>

    {
      /*
      The toggle. Inline and dependency-free so content pages stay at zero
      module JavaScript — a theme switch is not worth hydrating a framework for.

      localStorage is written ONLY on click. A theme is something the visitor
      explicitly chose, which is exactly the exception CLAUDE.md allows; storing
      one they never asked for would not be.
    */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;

        function active() {
          return (
            root.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          );
        }

        function label(theme) {
          btn.setAttribute(
            'aria-label',
            theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
          );
          btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }

        label(active());

        btn.addEventListener('click', function () {
          var next = active() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('qo-theme', next);
          } catch (e) {
            /* storage unavailable — the choice still applies for this page */
          }
          label(next);
        });
      })();
    </script>
  </body>
</html>
